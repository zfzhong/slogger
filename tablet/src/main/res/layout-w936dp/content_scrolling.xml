<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context="com.application.tablet.ConfigScrollingActivity"
    tools:showIn="@layout/activity_config_scrolling">

    <androidx.core.widget.NestedScrollView
        android:layout_width="840dp"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Menu items -->
            <EditText
                android:id="@+id/id_device_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/device_name" />

            <EditText
                android:id="@+id/id_protocol"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/protocol_name" />

            <EditText
                android:id="@+id/id_start_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/start_time" />

            <EditText
                android:id="@+id/id_end_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/end_time" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/accel_label"
                />

            <Spinner
                android:id="@+id/id_accel_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:prompt="@string/accel_title"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/gyro_label"
                />

            <Spinner
                android:id="@+id/id_gyro_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:prompt="@string/gyro_title"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/ble_label"
                />

            <Spinner
                android:id="@+id/id_ble_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:prompt="@string/ble_title"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/ble_scan_power"
                />
            <Spinner
                android:id="@+id/id_ble_scan_power_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                />

            <EditText
                android:id="@+id/id_ble_scan_interval"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="BLE Scan/Rest intervals: (e.g., 20/20)" />

            <EditText
                android:id="@+id/id_ble_scan_filter_device_names"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="BLE Filter Device Names: (e.g., Pix07,Pix08)" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/ble_ad_mode"
                />
            <Spinner
                android:id="@+id/id_ble_ad_mode_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/ble_ad_power"
                />
            <Spinner
                android:id="@+id/id_ble_ad_power_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                />

            <!-- Add more items as needed -->
            <Button
                android:id="@+id/id_delete"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Delete Files" />

            <Button
                android:id="@+id/id_save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Save" />
        </LinearLayout>

    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>